# Core AI key
GEMINI_API_KEY=your-gemini-api-key

# Supabase (frontend + backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub and Apify
GITHUB_PAT=your-github-personal-access-token
APIFY_API_TOKEN=your-apify-api-token

# Supabase (server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase (client-side Vite usage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# OpenAI + other third-party services
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_USDA_API_KEY=your-usda-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cloudflare
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_STREAM_KEY=your-cloudflare-stream-key
