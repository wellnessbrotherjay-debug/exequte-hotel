{
  "name": "hotelfit-solutions",
  "private": true,
  "workspaces": [
    "APPS/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx -y concurrently \"npm run dev:glvt\" \"npm run dev:admin\"",
    "dev:glvt": "npm run dev -w APPS/web-glvt",
    "dev:admin": "npm run dev -w APPS/app-admin",
    "build": "npm run build --workspaces"
  }
}